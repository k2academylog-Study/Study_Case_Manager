# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
INSTITUTION_TIMEZONE=Asia/Kolkata
CONTACT_EMAIL=

# Supabase. Use the publishable/anon key for user sessions and keep the service role on servers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Standalone Next.js and FastAPI development. Vercel supplies AI_SERVICE_URL via a binding.
AI_BACKEND_URL=http://localhost:8000
INTERNAL_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_INPUT_USD_PER_MILLION=0.15
AI_OUTPUT_USD_PER_MILLION=0.60

# WhatsApp Business Cloud API. Use the version supported by your Meta application.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=

# Resend and delivery webhooks
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=

# Background processing
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

